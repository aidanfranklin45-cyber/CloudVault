{
  "hosting": {
    "site": "cloudvault-35a9b-6b3db",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "supabase/**",
      "graphify-out/**",
      "tests/**",
      "test-results/**",
      "playwright-report/**",
      ".agents/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "input.css",
      "deno.json",
      "deno.lock"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
