{
  "hosting": {
    "site": "cloudvault-35a9b-6b3db",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      ".*/**",
      "**/.*",
      "**/.*/**",
      "node_modules/**",
      "**/node_modules/**",
      "functions/**",
      "supabase/**",
      "**/supabase/**",
      "graphify-out/**",
      "**/graphify-out/**",
      "tests/**",
      "**/tests/**",
      "test-results/**",
      "**/test-results/**",
      "playwright-report/**",
      "**/playwright-report/**",
      "**/*.md",
      "**/*.sql",
      "**/*.log",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "input.css",
      "deno.json",
      "deno.lock",
      "playwright.config.*",
      "repomix.config.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), payment=(self 'https://js.stripe.com')"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
